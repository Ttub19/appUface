# Copy this file to .env (same folder as docker-compose.yml) and fill in real
# values. Never commit the real .env.

# ---- PostgreSQL ----
POSTGRES_USER=faceshape
POSTGRES_PASSWORD=faceshape
POSTGRES_DB=faceshape

# ---- Auth / JWT ----
# Generate a real random secret, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
# Only matters if you call the API directly (e.g. via /docs on :8000) from a
# different origin than the frontend. Same-origin calls through the nginx
# proxy at :5173 never hit CORS at all.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- App ----
ENVIRONMENT=development
DEBUG=true
