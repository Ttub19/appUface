# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Database ----
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://faceshape:1900@localhost:5432/faceshape
# ---- Auth / JWT ----
# Generate a real random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=bjJwC1j5USEHOla0d4rBiXYI3Rp-PG_bhWIxN7HdjV_ugJ8g3RSVkdWQ0qeqoCoK
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
# Comma-separated list of front-end origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Admin ----
# อีเมลที่ให้เป็น admin (คั่นด้วย ,) — ใส่เฉพาะอีเมลที่สมัครไว้แล้ว
ADMIN_EMAILS=

# ---- App ----
ENVIRONMENT=development
DEBUG=True
# ---- สร้างภาพทรงผมสมจริง (AI) — เว้นว่างทั้งหมด = ปิดฟีเจอร์ ----
# auto (ค่าเริ่มต้น) = ใช้ Cloudflare ถ้าใส่ไว้ ไม่งั้นใช้ Gemini | cloudflare | gemini | off
HAIR_AI_PROVIDER=auto
HAIR_AI_DAILY_LIMIT=5
# A) Cloudflare Workers AI (ฟรี): dash.cloudflare.com -> AI -> Workers AI -> Use REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# B) Google Gemini (คุณภาพสูงกว่า, ใช้เครดิต Google Cloud): aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
